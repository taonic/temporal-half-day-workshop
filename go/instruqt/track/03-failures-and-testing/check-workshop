#!/bin/bash
# ABOUTME: Check script for Lab 3.
# Gate 1: every TODO in the lab files is gone.
# Gate 2: the package compiles and the two tests pass.
# Gate 3: since this lab started, a transfer hit a non-retryable deposit
#         failure, was fixed by updateToAccount, and completed.
. /root/workshop/shared/instruqt/lib.sh || { echo "FAIL: /root/workshop/shared/instruqt/lib.sh is missing. The sandbox clone is broken."; exit 1; }
. /root/workshop/go/instruqt/lib-go.sh || { echo "FAIL: /root/workshop/go/instruqt/lib-go.sh is missing. The sandbox clone is broken."; exit 1; }
cd "$GO_DIR" || fail "Workshop directory is missing."

require_no_todos lab3 activities.go workflow.go workflow_test.go
go_build_gate lab3
require_code lab3/activities.go "NewNonRetryableApplicationError" "Deposit in lab3/activities.go never returns a non-retryable error."
require_code lab3/workflow.go "SetUpdateHandlerWithOptions" "lab3/workflow.go never registers the updateToAccount Update handler."
require_code lab3/workflow.go "AllHandlersFinished" "lab3/workflow.go returns without waiting for the Update handler to finish."
pass "Non-retryable error, Update handler and handler wait present"
require_code lab3/workflow_test.go "StatusTimedOut" "TestApprovalTimesOut never asserts StatusTimedOut."
require_code lab3/workflow_test.go "UpdateWorkflow" "TestInvalidAccountFixedByUpdate never sends the Update."

if ! OUT=$(go test -count=1 -v ./lab3 2>&1); then
    echo "$OUT" | grep -E '^(---|\s+workflow_test|FAIL|panic)' | tail -20
    fail "go test ./lab3 failed. Fix the tests above, then check again."
fi
PASSED=$(grep -c '^--- PASS' <<<"$OUT")
[ "${PASSED:-0}" -ge 2 ] || fail "Only ${PASSED:-0} test passed. Both TestApprovalTimesOut and TestInvalidAccountFixedByUpdate must pass."
pass "$PASSED tests pass"
check_lab3_runtime "$(since 03)"

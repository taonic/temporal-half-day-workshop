#!/bin/bash
# ABOUTME: Solve script for Lab 2. Runs on Skip and on `instruqt track test`.
# Copies the finished code into lab2, starts its Worker, then plays the
# learner's part from the CLI so the check passes.
set -uo pipefail
. /root/workshop/shared/instruqt/lib.sh || { echo "FAIL: /root/workshop/shared/instruqt/lib.sh is missing. The sandbox clone is broken."; exit 1; }
. /root/workshop/go/instruqt/lib-go.sh || { echo "FAIL: /root/workshop/go/instruqt/lib-go.sh is missing. The sandbox clone is broken."; exit 1; }
cd "$GO_DIR" || exit 0

copy_solution 2
kill_go_processes
terminate_workshop_workflows "Lab 2 solve"
start_solve_worker 2 || exit 0

drive_lab2

kill "$SOLVE_WORKER_PID" 2>/dev/null || true
exit 0

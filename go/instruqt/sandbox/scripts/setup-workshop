#!/bin/bash
# ABOUTME: Sandbox preset setup script. Provisions the whole workshop sandbox.
#
# This is the preset's lifecycle script, named for the container in
# ../config.yml. It ships with `instruqt sandbox push` + `instruqt sandbox
# publish`, NOT with `instruqt track push`.
#
# Because it arrives with the preset rather than inside a git clone, it can
# install its own dependencies, git included. The base image is relied on for
# nothing beyond a Debian userland.
#
# Steps:
#   1. System packages, git included
#   2. Clone the workshop repo
#   3. Go toolchain
#   4. Temporal CLI
#   5. Go module download and build cache warm-up
#   6. code-server (the Code Editor tab), gopls and the Go extension
#   7. Environment for every shell
#   8. Start the Temporal dev server and code-server
#
# See ../../README.md for how to ship a change to this file.
set -euo pipefail

# Pin WORKSHOP_REF to a tag or a commit before a live workshop so every
# attendee gets the same code regardless of what landed on main that morning.
WORKSHOP_REPO="${WORKSHOP_REPO:-https://github.com/taonic/temporal-half-day-workshop.git}"
WORKSHOP_REF="${WORKSHOP_REF:-main}"
WORKSHOP_DIR="${WORKSHOP_DIR:-/root/workshop}"
GO_DIR="${WORKSHOP_DIR}/go"
# Keep in step with the `toolchain` line in go/go.mod. Any release at or above
# it works; GOTOOLCHAIN=local (step 3) stops Go from fetching a different one.
GO_VERSION="1.24.13"
# code-server is the Code Editor tab. gopls v0.20.0 is the newest that builds
# with Go 1.24; later releases need a newer Go.
CODE_SERVER_VERSION="4.144.0"
GOPLS_VERSION="v0.20.0"

log() { echo "==> $*"; }

# Lifecycle scripts can run without HOME. Go needs it for GOPATH and GOCACHE.
export HOME="${HOME:-/root}"

# 0. Wait for Instruqt host bootstrap.
until [ -f /opt/instruqt/bootstrap/host-bootstrap-completed ]; do
    sleep 1
done

# 1. System packages. The complete list, git included: nothing here is
#    inherited from the base image, so add a new binary dependency to this
#    list and nowhere else.
log "Installing system packages"
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq --no-install-recommends \
    ca-certificates \
    curl \
    git \
    jq \
    less \
    vim-tiny \
    nano \
    bash-completion

# 2. Clone the workshop repo. Skipped when the directory exists, which is how
#    a local test run points the sandbox at an uncommitted working tree.
if [ ! -d "${WORKSHOP_DIR}" ]; then
    log "Cloning ${WORKSHOP_REPO} at ${WORKSHOP_REF}"
    git clone --depth 1 --branch "${WORKSHOP_REF}" "${WORKSHOP_REPO}" "${WORKSHOP_DIR}"
else
    log "${WORKSHOP_DIR} already exists, skipping the clone"
fi
for f in "${WORKSHOP_DIR}/shared/instruqt/lib.sh" "${GO_DIR}/instruqt/lib-go.sh"; do
    if [ ! -f "$f" ]; then
        echo "ERROR: $f is missing. WORKSHOP_REF=${WORKSHOP_REF} does not contain the lifecycle helpers." >&2
        exit 1
    fi
done

# 3. Go toolchain, from the official tarball rather than apt so this script
#    pins the version. Symlinked into /usr/local/bin because check and solve
#    scripts run non-interactively and never source a profile.
#
#    GOTOOLCHAIN=local goes in $GOROOT/go.env, which every go invocation reads
#    regardless of HOME or profile. Without it, a go.mod `toolchain` line newer
#    than GO_VERSION makes the first `go run` download a second toolchain.
case "$(dpkg --print-architecture)" in
    amd64) GO_ARCH=amd64 ;;
    arm64) GO_ARCH=arm64 ;;
    *) echo "ERROR: unsupported architecture $(dpkg --print-architecture)" >&2; exit 1 ;;
esac
log "Installing Go ${GO_VERSION} (${GO_ARCH})"
rm -rf /usr/local/go
curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${GO_ARCH}.tar.gz" | tar -C /usr/local -xzf -
ln -sf /usr/local/go/bin/go /usr/local/bin/go
ln -sf /usr/local/go/bin/gofmt /usr/local/bin/gofmt
sed -i 's/^GOTOOLCHAIN=.*/GOTOOLCHAIN=local/' /usr/local/go/go.env
grep -q '^GOTOOLCHAIN=local' /usr/local/go/go.env || echo 'GOTOOLCHAIN=local' >> /usr/local/go/go.env
go version

# 4. Temporal CLI.
log "Installing the Temporal CLI"
curl -sSf https://temporal.download/cli.sh | sh
ln -sf /root/.temporalio/bin/temporal /usr/local/bin/temporal

# 5. Module download and build cache. Every page links the same SDK, so
#    compiling each lab's finished code once puts the SDK and its
#    dependencies in GOCACHE. The learner's first `go run` then compiles only
#    their own package, in a second or two, instead of the whole dependency
#    graph. Each challenge's setup script recreates its lab folder.
log "Downloading Go modules and warming the build cache"
cd "${GO_DIR}"
go mod download
for page in 1c 2c 3c; do
    bash "${WORKSHOP_DIR}/shared/steps.sh" "${GO_DIR}" restore "${page}"
    go build "./lab${page:0:1}/..."
done
go test -count=1 ./lab3 >/dev/null
rm -rf lab1 lab2 lab3

# 6. code-server, the Code Editor tab. Instruqt's built-in editor has no Go
#    support, and whether it reloads a file changed on disk is undocumented;
#    `apply` changes files on disk. VS Code reloads an open file that has no
#    unsaved edits, so autosave stays on. Nothing reformats on save: a
#    formatter could rewrite the region markers `apply` relies on. The Go
#    welcome page, the AI chat panel and vulncheck (whose setting gopls
#    v0.20 rejects with an error toast) are turned off.
log "Installing code-server ${CODE_SERVER_VERSION}, gopls and the Go extension"
curl -fsSL https://code-server.dev/install.sh | sh -s -- --version "${CODE_SERVER_VERSION}"
GOBIN=/usr/local/bin go install "golang.org/x/tools/gopls@${GOPLS_VERSION}"
code-server --install-extension golang.go@0.58.0
mkdir -p /root/.local/share/code-server/User
cat > /root/.local/share/code-server/User/settings.json << 'SETTINGS'
{
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 500,
  "editor.formatOnSave": false,
  "[go]": {
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never"
    }
  },
  "go.showWelcome": false,
  "go.toolsManagement.autoUpdate": false,
  "go.toolsManagement.checkForUpdates": "off",
  "go.survey.prompt": false,
  "chat.disableAIFeatures": true,
  "chat.commandCenter.enabled": false,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.editor.enablePreview": false,
  "security.workspace.trust.enabled": false,
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "telemetry.telemetryLevel": "off",
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": false,
  "update.mode": "none",
  "workbench.colorTheme": "Default Dark Modern",
  "go.diagnostic.vulncheck": "Off"
}
SETTINGS

# 7. Environment for every shell. go/bin holds `apply` and `reset`.
#    /etc/profile.d covers login shells and the /etc/bash.bashrc line covers
#    interactive non-login shells, which is what Instruqt's terminal tabs
#    open. Putting them only in /etc/bash.bashrc does not work: Ubuntu's
#    /root/.bashrc returns early for non-interactive shells.
log "Writing shell environment"
cat > /etc/profile.d/workshop.sh << EOF
export TEMPORAL_ADDRESS="127.0.0.1:7233"
export GOTOOLCHAIN=local
export PATH="${GO_DIR}/bin:/usr/local/go/bin:/root/go/bin:\$PATH"
EOF
chmod 0644 /etc/profile.d/workshop.sh

if ! grep -q 'profile.d/workshop.sh' /etc/bash.bashrc 2>/dev/null; then
    cat >> /etc/bash.bashrc << EOF

# Workshop environment
[ -f /etc/profile.d/workshop.sh ] && . /etc/profile.d/workshop.sh
[ -f /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion
cd ${GO_DIR} 2>/dev/null || true
EOF
fi

# 8. Temporal dev server and code-server.
log "Starting the Temporal dev server"
nohup temporal server start-dev \
    --ip 0.0.0.0 \
    --db-filename /root/temporal.db \
    --log-level warn \
    > /tmp/temporal-server.log 2>&1 &

HEALTHY=false
for _ in $(seq 1 60); do
    if temporal operator cluster health --address 127.0.0.1:7233 >/dev/null 2>&1; then
        HEALTHY=true
        break
    fi
    sleep 1
done
if [ "${HEALTHY}" != true ]; then
    echo "ERROR: Temporal dev server did not become healthy. See /tmp/temporal-server.log." >&2
    tail -20 /tmp/temporal-server.log >&2 || true
    exit 1
fi
log "Temporal server healthy"

nohup code-server \
    --bind-addr 0.0.0.0:8080 \
    --auth none \
    --disable-telemetry \
    --disable-update-check \
    --disable-workspace-trust \
    --disable-getting-started-override \
    "${GO_DIR}" \
    > /tmp/code-server.log 2>&1 &
for _ in $(seq 1 30); do
    curl -fs -o /dev/null http://127.0.0.1:8080/healthz && break
    sleep 1
done
curl -fsS -o /dev/null http://127.0.0.1:8080/healthz || {
    echo "ERROR: code-server did not start. See /tmp/code-server.log." >&2
    tail -20 /tmp/code-server.log >&2 || true
    exit 1
}
log "code-server healthy"

log "Sandbox provisioning complete."

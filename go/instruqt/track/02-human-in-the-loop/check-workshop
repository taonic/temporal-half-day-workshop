#!/bin/bash
# ABOUTME: Check script for Lab 2.
# Gate 1: every TODO in workflow.go is gone.
# Gate 2: the package compiles and has the Query, Signal and timer.
# Gate 3: since this lab started, one transfer completed through the approve
#         Signal and one timed out on the durable timer.
. /root/workshop/shared/instruqt/lib.sh || { echo "FAIL: /root/workshop/shared/instruqt/lib.sh is missing. The sandbox clone is broken."; exit 1; }
. /root/workshop/go/instruqt/lib-go.sh || { echo "FAIL: /root/workshop/go/instruqt/lib-go.sh is missing. The sandbox clone is broken."; exit 1; }
cd "$GO_DIR" || fail "Workshop directory is missing."

require_no_todos lab2 workflow.go
go_build_gate lab2
require_code lab2/workflow.go "SetQueryHandler" "lab2/workflow.go never registers the getStatus Query handler."
pass "getStatus Query handler present"
require_code lab2/workflow.go "GetSignalChannel" "lab2/workflow.go never listens for the approve Signal."
pass "approve Signal channel present"
require_code lab2/workflow.go "AwaitWithTimeout" "lab2/workflow.go never waits with a deadline. Use workflow.AwaitWithTimeout."
pass "Approval deadline present"
check_lab2_runtime "$(since 02)"
